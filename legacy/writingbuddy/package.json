{
  "name": "editing-suggestions",
  "version": "0.1.0",
  "description": "编辑建议 — 中文 AI 校对 Obsidian 插件：全文语法检查、正文波浪线标记、悬浮卡片一键替换、自定义指令、快照备份",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production && node scripts/deploy.mjs",
    "check": "tsc -noEmit -skipLibCheck",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "proofreading",
    "chinese",
    "ai",
    "grammar"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0"
  }
}
